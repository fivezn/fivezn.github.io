	.orbit-small { border-color: var(--line); height: 58%; transform: translate(-50%, -50%) rotate(55deg); width: 110%; }
	.visual-core { align-items: center; background: var(--accent); color: var(--paper); display: flex; flex-direction: column; height: 43%; justify-content: center; left: 50%; position: absolute; text-align: center; top: 50%; transform: translate(-50%, -50%); width: 43%; }
