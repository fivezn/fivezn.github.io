	.shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
	main { overflow: hidden; }
	.nav { align-items: center; display: flex; justify-content: space-between; padding: 28px 0; border-bottom: 1px solid var(--line); }
	.wordmark { align-items: center; color: var(--ink); display: flex; font-size: 13px; font-weight: 700; gap: 11px; letter-spacing: -.02em; text-decoration: none; }
