<script>
	const startLab = [64.1, 9.2, -43.2];
	const endLab = [54.8, 49.7, -46.4];

	function srgbToLinear(value) {
		const channel = value / 255;
		return channel <= 0.04045 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
	}

	function hexToLab(hex) {
		const rgb = hex.match(/\w\w/g)?.map((channel) => srgbToLinear(parseInt(channel, 16)));
		if (!rgb) return startLab;
		const [r, g, b] = rgb;
		const x = (r * 0.4124 + g * 0.3576 + b * 0.1805) / 0.95047;
		const y = (r * 0.2126 + g * 0.7152 + b * 0.0722);
		const z = (r * 0.0193 + g * 0.1192 + b * 0.9505) / 1.08883;
		const f = (value) => value > 0.008856 ? Math.cbrt(value) : (7.787 * value) + 16 / 116;
		return [116 * f(y) - 16, 500 * (f(x) - f(y)), 200 * (f(y) - f(z))];
	}

	function labToHex([lightness, a, b]) {
		const f = (value) => {
			const cube = value ** 3;
			return cube > 0.008856 ? cube : (value - 16 / 116) / 7.787;
		};
		const y = f((lightness + 16) / 116);
		const x = f(a / 500 + (lightness + 16) / 116) * 0.95047;
		const z = f((lightness + 16) / 116 - b / 200) * 1.08883;
		const toSrgb = (value) => {
			const channel = value <= 0.0031308 ? 12.92 * value : 1.055 * Math.pow(value, 1 / 2.4) - 0.055;
			return Math.max(0, Math.min(255, Math.round(channel * 255)));
		};
		return `#${[toSrgb(x * 3.2406 - y * 1.5372 - z * 0.4986), toSrgb(x * -0.9689 + y * 1.8758 + z * 0.0415), toSrgb(x * 0.0557 - y * 0.204 + z * 1.057)].map((value) => value.toString(16).padStart(2, '0')).join('')}`;
	}

	const fromLab = hexToLab('#3d9fdb');
	const toLab = hexToLab('#a463e0');
	const updateAccent = () => {
		const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
		const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
		const color = fromLab.map((value, index) => value + (toLab[index] - value) * progress);
		document.documentElement.style.setProperty('--accent', labToHex(color));
	};
	window.addEventListener('scroll', updateAccent, { passive: true });
	updateAccent();

	const ticker = document.querySelector('.ticker');
	const tickerTrack = document.querySelector('.ticker-track');
	const tickerSource = tickerTrack?.querySelector('.ticker-set');
	const updateTicker = () => {
		if (!ticker || !tickerTrack || !tickerSource) return;
		const sourceWidth = tickerSource.getBoundingClientRect().width;
		const requiredCopies = Math.ceil((ticker.getBoundingClientRect().width * 2) / sourceWidth);
		while (tickerTrack.children.length < requiredCopies) {
			const copy = tickerSource.cloneNode(true);
			copy.setAttribute('aria-hidden', 'true');
			tickerTrack.append(copy);
		}
		tickerTrack.style.setProperty('--ticker-loop-width', `${sourceWidth}px`);
	};
	window.addEventListener('resize', updateTicker);
	updateTicker();
	document.fonts?.ready.then(updateTicker);

	document.querySelectorAll('.language-button').forEach((button) => {
		button.addEventListener('click', () => {
			const language = button.dataset.language === 'fr' ? 'en' : 'fr';
			document.documentElement.lang = language;
			document.querySelectorAll('[data-fr][data-en]').forEach((element) => {
				const translatedMarkup = element.getAttribute(`data-${language}`);
				const fallbackMarkup = element.getAttribute('data-fr');
				if (translatedMarkup !== null || fallbackMarkup !== null) {
					element.innerHTML = translatedMarkup ?? fallbackMarkup ?? '';
				}
			});
			button.dataset.language = language;
			button.setAttribute('aria-pressed', String(language === 'en'));
			button.setAttribute('aria-label', language === 'fr' ? 'Switch language to English' : 'Passer le site en français');
			button.querySelectorAll('.language-option').forEach((option, index) => {
				option.classList.toggle('is-active', (language === 'fr' && index === 0) || (language === 'en' && index === 1));
			});
		});
	});
</script>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

